    "@angular/language-service": "~20.3.18",
    "@ionic/angular-toolkit": "^12.3.0",
    "@types/node": "^25.9.5",
    "codelyzer": "^6.0.2",
    "ng-packagr": "^20.3.2",
    "ts-node": "10.9.2",
    "typescript": "~5.9.3"
