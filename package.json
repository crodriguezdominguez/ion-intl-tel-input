  },
  "bugs": {
    "url": "https://github.com/azzamasghar1/ion-intl-tel-input/issues"
  },
  "keywords": [
    "ionic",
    "ionic 2",
    "ionic 3",
    "ionic 4",
    "ion-intl-tel-input",
    "intl tel input",
    "intl",
    "tel",
    "input",
    "international",
    "phone",
    "phonenumber",
